# Optional: LangSmith tracing for the LangGraph agents. Copy to .env.local and fill in.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=beyond-mcp-workshop
LANGCHAIN_CALLBACKS_BACKGROUND=false

# No Groq key here on purpose: each user brings their own key in the app (BYOK).
